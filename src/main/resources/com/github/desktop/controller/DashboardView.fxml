<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.github.desktop.controller.DashboardView"
            prefHeight="800.0" prefWidth="1200.0">

    <center>
        <VBox alignment="CENTER" spacing="16.0">
            <Label text="Menu Browser" prefWidth="160.0" alignment="CENTER">
                <font>
                    <Font name="Arial" size="16.0" />
                </font>
            </Label>
            <Button text="NAVIGATE" onAction="#onNavigateToBrowser" prefWidth="160.0" defaultButton="true">
                <font>
                    <Font name="Arial" size="12.0" />
                </font>
            </Button>
        </VBox>
    </center>

</BorderPane>
